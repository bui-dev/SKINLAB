{
  "realm": "skinlab-fake",
  "enabled": true,
  "displayName": "SkinLab Fake-Data Staging Realm",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "doctor", "description": "SkinLab Clinic Doctor Role" },
      { "name": "receptionist", "description": "SkinLab Clinic Receptionist Role" },
      { "name": "admin", "description": "SkinLab System Administrator Role" }
