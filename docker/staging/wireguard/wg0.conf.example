# WireGuard Staging VPN Configuration Example
# Place actual configuration under ./wireguard/config/wg0.conf outside Git.

[Interface]
Address = 10.13.13.1/24
ListenPort = 51820
PrivateKey = REPLACE_WITH_SERVER_PRIVATE_KEY
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE

# Admin Workstation Peer (Synthetic Admin)
[Peer]
PublicKey = REPLACE_WITH_ADMIN_PEER_PUBLIC_KEY
AllowedIPs = 10.13.13.2/32

