# SkinLab Staging Environment Configuration Example
# Copy to compose.env and adjust for local staging execution.

NODE_ENV=production
CLINIC_TIMEZONE=Asia/Ho_Chi_Minh

# Database Credentials
POSTGRES_DB=skinlab
POSTGRES_USER=skinlab
POSTGRES_PASSWORD=replace-with-staging-pg-password

# MinIO S3 Credentials
S3_ENDPOINT=http://minio:9000
S3_REGION=local
S3_BUCKET=skinlab-clinical-media
S3_ACCESS_KEY_ID=skinlab
S3_SECRET_ACCESS_KEY=replace-with-staging-minio-password
MINIO_ROOT_USER=skinlab
MINIO_ROOT_PASSWORD=replace-with-staging-minio-password

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-staging-keycloak-password
OIDC_ISSUER=http://keycloak:8080/realms/skinlab-fake
OIDC_JWKS_URL=http://keycloak:8080/realms/skinlab-fake/protocol/openid-connect/certs
OIDC_AUDIENCE=skinlab-api
OIDC_REQUIRED_ACR=2
OIDC_CLIENT_ID=skinlab-web
OIDC_CLIENT_SECRET=fake-web-client-secret
OIDC_REDIRECT_URI=https://localhost:443/api/auth/callback

# Internal BFF & API Configuration
API_INTERNAL_BASE_URL=https://gateway:9443/internal
API_BASE_URL=https://gateway:9443/internal
NEXT_PUBLIC_API_BASE_URL=https://localhost:443/api
SESSION_COOKIE_NAME=skinlab_session
LOGIN_ATTEMPT_COOKIE_NAME=skinlab_login_attempt

# Security Keys & Proofs (32-byte base64 encoded)
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BFF_EXCHANGE_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
GATEWAY_ASSERTION_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
GATEWAY_CLIENT_CERT_FINGERPRINT=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

