{
	admin off
	auto_https off
}

# Task 4A contract only. Mount the three certificate files and use private
# Docker networking; do not publish the context-signer port.
https://:8443 {
	tls /run/secrets/caddy-server-cert.pem /run/secrets/caddy-server-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /run/secrets/clinic-client-ca.pem
		}
	}

	@gatewayProtectedAuth path /api/auth/callback /api/auth/refresh
	route @gatewayProtectedAuth {
		# Remove every caller-controlled copy before Caddy makes its own evidence.
		request_header -X-SkinLab-Gateway-Assertion
		request_header -X-SkinLab-Verified-Device-Fingerprint
		request_header -X-SkinLab-Verified-Access-Context

		forward_auth https://context-signer:8443 {
			uri /sign
			transport http {
				tls
				tls_client_auth /run/secrets/caddy-signer-client-cert.pem /run/secrets/caddy-signer-client-key.pem
				tls_trust_pool file /run/secrets/context-signer-server-ca.pem
				tls_server_name context-signer
			}
			header_up X-SkinLab-Verified-Device-Fingerprint {tls_client_fingerprint}
			header_up X-SkinLab-Verified-Access-Context clinic
			header_up X-SkinLab-Original-Method {method}
			header_up X-SkinLab-Original-Path {path}
			copy_headers X-SkinLab-Gateway-Assertion
		}

		reverse_proxy https://admin-skinlab:3000 {
			transport http {
				tls
				tls_trust_pool file /run/secrets/internal-server-ca.pem
				tls_server_name admin-skinlab
			}
		}
	}

	reverse_proxy https://admin-skinlab:3000 {
		transport http {
			tls
			tls_trust_pool file /run/secrets/internal-server-ca.pem
			tls_server_name admin-skinlab
		}
	}
}

# Remote administration uses a separate listener and certificate authority. It
# produces an explicit remote context; API policy accepts only the admin role.
https://:8444 {
	tls /run/secrets/caddy-server-cert.pem /run/secrets/caddy-server-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /run/secrets/remote-admin-client-ca.pem
		}
	}

	@gatewayProtectedAuth path /api/auth/callback /api/auth/refresh
	route @gatewayProtectedAuth {
		request_header -X-SkinLab-Gateway-Assertion
		request_header -X-SkinLab-Verified-Device-Fingerprint
		request_header -X-SkinLab-Verified-Access-Context
		forward_auth https://context-signer:8443 {
			uri /sign
			transport http {
				tls
				tls_client_auth /run/secrets/caddy-signer-client-cert.pem /run/secrets/caddy-signer-client-key.pem
				tls_trust_pool file /run/secrets/context-signer-server-ca.pem
				tls_server_name context-signer
			}
			header_up X-SkinLab-Verified-Device-Fingerprint {tls_client_fingerprint}
			header_up X-SkinLab-Verified-Access-Context remote
			header_up X-SkinLab-Original-Method {method}
			header_up X-SkinLab-Original-Path {path}
			copy_headers X-SkinLab-Gateway-Assertion
		}
		reverse_proxy https://admin-skinlab:3000 {
			transport http {
				tls
				tls_trust_pool file /run/secrets/internal-server-ca.pem
				tls_server_name admin-skinlab
			}
		}
	}
	reverse_proxy https://admin-skinlab:3000 {
		transport http {
			tls
			tls_trust_pool file /run/secrets/internal-server-ca.pem
			tls_server_name admin-skinlab
		}
	}
}

# The BFF uses this listener for its signed internal API commands. It is not a
# browser route: only the BFF mTLS certificate may connect, then Caddy presents
# its own separate mTLS certificate to the API.
https://:9443 {
	tls /run/secrets/caddy-server-cert.pem /run/secrets/caddy-server-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /run/secrets/bff-client-ca.pem
		}
	}

	@internalApi path /internal/*
	handle @internalApi {
		reverse_proxy https://api-skinlab:3001 {
			transport http {
				tls
				tls_client_auth /run/secrets/caddy-api-client-cert.pem /run/secrets/caddy-api-client-key.pem
				tls_trust_pool file /run/secrets/internal-server-ca.pem
				tls_server_name api-skinlab
			}
		}
	}

	respond "Not found" 404
}
