NODE_ENV=development
HOST=0.0.0.0
PORT=3001

DATABASE_URL=postgresql://skinlab:skinlab@localhost:5432/skinlab
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skinlab-private
S3_ACCESS_KEY_ID=skinlab-local
S3_SECRET_ACCESS_KEY=replace-with-a-local-development-secret
CLINIC_TIMEZONE=Asia/Ho_Chi_Minh

OIDC_ISSUER=https://identity.example.test
OIDC_AUDIENCE=skinlab-api
OIDC_REQUIRED_ACR=2

# Generate independent 32-byte keys and encode each as base64.
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
BFF_EXCHANGE_HMAC_KEY=replace-with-base64-encoded-32-byte-key

# Use absolute paths. The files remain outside Git.
INTERNAL_TLS_CERT_PATH=/run/secrets/skinlab-api-cert.pem
INTERNAL_TLS_KEY_PATH=/run/secrets/skinlab-api-key.pem
INTERNAL_TLS_CLIENT_CA_PATH=/run/secrets/caddy-client-ca.pem
GATEWAY_CLIENT_CERT_FINGERPRINT=replace-with-64-character-sha256-hex
