{
  "name": "@skinlab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.3",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --config ../packages/eslint-config/index.mjs --max-warnings=0",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:test": "prisma migrate deploy",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc6 --noEmit"
  },
  "dependencies": {
    "@skinlab/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-fastify": "12.4.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@skinlab/eslint-config": "workspace:*",
    "@skinlab/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pg": "8.15.5",
    "@testcontainers/postgresql": "12.2.1",
    "prisma": "7.10.1",
    "tsx": "4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.0"
  }
}
