generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  payload    Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  scope          String
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model RegisteredDevice {
  id                     String   @id @default(cuid())
  certificateFingerprint String   @unique
  label                  String
  isActive               Boolean  @default(true)
  registeredAt           DateTime @default(now())

  @@map("registered_devices")
}

model OidcLoginAttempt {
  id                    String   @id @default(cuid())
  stateHash             String   @unique
  nonceHash             String
  codeVerifierCiphertext String
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime @default(now())

  @@index([expiresAt])
  @@map("oidc_login_attempts")
}

model UserSession {
  id                     String   @id @default(cuid())
  sessionIdHash          String   @unique
  subject                String
  role                   String
  acr                    String
  deviceFingerprint      String
  accessContext          String
  refreshTokenHash       String
  refreshTokenCiphertext String
  expiresAt              DateTime
  absoluteExpiresAt      DateTime
  lastActivityAt         DateTime
  refreshStartedAt       DateTime?
  revokedAt              DateTime?
  revocationReason       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([subject])
  @@index([expiresAt])
  @@map("user_sessions")
}

model IdentityAccount {
  subject   String   @id
  role      String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("identity_accounts")
}

model BffExchangeNonce {
  id        String   @id @default(cuid())
  nonceHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("bff_exchange_nonces")
}

model GatewayAssertionNonce {
  id        String   @id @default(cuid())
  nonceHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("gateway_assertion_nonces")
}

model JobRun {
  id           String    @id @default(cuid())
  jobName      String
  scheduledFor DateTime
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String    // "RUNNING", "COMPLETED", "FAILED"
  outcome      Json?
  errorSummary String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([jobName, scheduledFor])
  @@index([status])
  @@index([scheduledFor])
  @@map("job_runs")
}
