{
  "name": "skinlab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "22.23.3",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "prepare": "husky admin-skinlab/.husky",
    "workspace:verify": "node tools/workspace/verify-root-workspace.mjs",
    "security:secrets": "bash tools/security/scan-secrets.sh",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
