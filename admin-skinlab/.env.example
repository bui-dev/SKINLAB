# Server-only API origin. Never expose secrets through NEXT_PUBLIC_ variables.
API_BASE_URL=http://localhost:3001

# Public API origin used by browser-side requests. This value must not be secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Server-only OIDC/BFF configuration. Never prefix these values with NEXT_PUBLIC_.
OIDC_ISSUER=https://identity.example.test
OIDC_CLIENT_ID=skinlab-web
OIDC_CLIENT_SECRET=replace-with-server-only-client-secret
OIDC_REDIRECT_URI=https://localhost:3000/auth/callback
OIDC_REQUIRED_ACR=2
API_INTERNAL_BASE_URL=https://api-skinlab:3001
BFF_EXCHANGE_HMAC_KEY=replace-with-base64-encoded-32-byte-key
SESSION_COOKIE_NAME=skinlab_session
LOGIN_ATTEMPT_COOKIE_NAME=skinlab_login_attempt
